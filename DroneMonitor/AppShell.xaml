<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DroneMonitor.Views"
    x:Class="DroneMonitor.AppShell">

    <Shell.TitleView >
        <Grid ColumnDefinitions="*,Auto" >
            <Label Text="Drone Monitor" FontSize="20" VerticalOptions="Center" Grid.Column="0" Padding="10" />
            <Button x:Name="bleConnectBtn"
                    BackgroundColor="Blue"
                    Text=""
                    Clicked="OnBleConnectClicked"
                    Grid.Column="1"
                    VerticalOptions="Start"/>
        </Grid>
    </Shell.TitleView>

    <!-- 画面は MainPage の1枚。Flight / Gains の切り替えは MainPage の中で行う -->
    <TabBar x:Name="MainTabBar">
        <ShellContent ContentTemplate="{DataTemplate views:MainPage}" />
    </TabBar>
</Shell>
