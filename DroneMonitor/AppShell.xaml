<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DroneMonitor.Views"
    x:Class="DroneMonitor.AppShell">

    <Shell.TitleView >
        <Grid HeightRequest="80" ColumnDefinitions="*,Auto" >
            <Label Text="Drone Monitor" FontSize="20" VerticalOptions="Center" Grid.Column="0" Padding="10" />
            <Button x:Name="bleConnectBtn"
                    BackgroundColor="Blue"
                    Text=""
                    HeightRequest="20"
                    Clicked="OnBleConnectClicked"
                    Grid.Column="1"
                    VerticalOptions="Start"
                    Margin="0,5,0,0"/>
        </Grid>
    </Shell.TitleView>

    <TabBar>
        <ShellContent Title="Home" ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Notification" ContentTemplate="{DataTemplate views:ControlDataPage}" />
    </TabBar>
</Shell>
