<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:views="clr-namespace:DroneMonitor.Views"
            x:Class="DroneMonitor.MainPage"
            BarBackgroundColor="White"
            BarTextColor="Black"
            SelectedTabColor="Blue"
            UnselectedTabColor="Gray"
            Title="BT DRONE">

    <!-- ホームタブ -->
    <NavigationPage Title="Home" IconImageSource="home.png">
        <x:Arguments>
            <views:HomePage />
        </x:Arguments>
    </NavigationPage>

    <!-- 設定タブ -->
    <NavigationPage Title="Settings" IconImageSource="settings.png">
        <x:Arguments>
            <views:DashboardPage />
        </x:Arguments>
    </NavigationPage>

    <!-- 通知タブ -->
    <NavigationPage Title="Notifications" IconImageSource="notifications.png">
        <x:Arguments>
            <views:NotificationPage />
        </x:Arguments>
    </NavigationPage>

</TabbedPage>