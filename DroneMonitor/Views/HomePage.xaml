<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DroneMonitor.Views.HomePage"
             xmlns:android="clr-namespace:DroneMonitor.Platforms.Android"
             Title="BT DRONE">
    <Grid ColumnDefinitions="*"
              RowDefinitions="Auto,*,*, *,*,*, *, 200" Margin="20,0,20,0">

        <!-- メッセージ: Gridで実装、左が伸びて右にラジオボタン群を右寄せ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左: msgWindow / msgPad を縦に並べる -->
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4" HorizontalOptions="Center">
                <Label x:Name="msgWindow" Text="…" HorizontalOptions="Center"  />
                <Label x:Name="msgPad"    Text="…" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- 右: ラジオボタン群を右寄せ -->
            <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="8">
                <Label Text="ターゲット:" VerticalOptions="Center" />
                <RadioButton x:Name="TypeVert" Content="A" GroupName="TargetGroup"/>
                <RadioButton x:Name="TypeXpider" Content="B" GroupName="TargetGroup" IsChecked="True" />
            </HorizontalStackLayout>
        </Grid>

        <!-- 横型 Slider を縦積み -->
        <Slider x:Name="S1SeekBar"    Maximum="100" Value="50" Grid.Row="1" Grid.Column="0" Margin="20,10,20,10" />
        <Slider x:Name="S2SeekBar"    Maximum="100" Value="50" Grid.Row="2" Grid.Column="0" Margin="20,10,20,10" />
        <Slider x:Name="throttleSeekBar" Maximum="100" Value="0" Grid.Row="3" Grid.Column="0" Margin="20,10,20,10" />
        <Slider x:Name="S3SeekBar"    Maximum="100" Value="50" Grid.Row="4" Grid.Column="0" Margin="20,10,20,10" />
        <Slider x:Name="S4SeekBar"    Maximum="100" Value="50" Grid.Row="5" Grid.Column="0" Margin="20,10,20,10" />

        <HorizontalStackLayout Grid.Row="6" Grid.Column="0" HorizontalOptions="Center">
            <!-- 操作ボタン -->
            <Button x:Name="throttleMinusBtn" Text="–" Margin="5"/>
            <Button x:Name="throttlePlusBtn"  Text="+" Margin="5"/>
        </HorizontalStackLayout>

        <!-- AndroidのJoystickView -->
        <OnPlatform x:TypeArguments="View">
            <On Platform="Android">
                <android:JoystickView x:Name="joystickView"  Grid.Row="7" Grid.Column="0"/>
            </On>
        </OnPlatform>
    </Grid>

</ContentPage>