<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DroneMonitor.Views.ControlDataView">
    <ScrollView>
        <VerticalStackLayout Padding="12,8" Spacing="12">

            <!-- 制御モード（押したモードを送信し、現在のモードを強調表示） -->
            <Border Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="制御モード" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="modeNoneButton" Text="None（停止）" Clicked="OnModeButtonClicked" MinimumWidthRequest="110" />
                        <Button x:Name="modeMimoButton" Text="MIMO" Clicked="OnModeButtonClicked" MinimumWidthRequest="110" />
                        <Button x:Name="modePidButton" Text="PID" Clicked="OnModeButtonClicked" MinimumWidthRequest="110" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 姿勢（大きな数字で表示） -->
            <Border Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
                    <Label Grid.Row="0" Grid.ColumnSpan="3" Text="姿勢 [deg]" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="0" Text="Pitch" TextColor="Gray" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Grid.Column="1" Text="Roll" TextColor="Gray" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Grid.Column="2" Text="Yaw" TextColor="Gray" HorizontalOptions="Center" />
                    <Label x:Name="pitchValueLabel" Grid.Row="2" Grid.Column="0" Text="-" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="rollValueLabel" Grid.Row="2" Grid.Column="1" Text="-" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label x:Name="yawValueLabel" Grid.Row="2" Grid.Column="2" Text="-" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
                </Grid>
            </Border>

            <!-- センサ値（行: Accel / Gyro、列: X / Y / Z）。Gains タブでは ShowSensors="False" で隠す -->
            <Border x:Name="sensorBorder" Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                <Grid x:Name="sensorGrid" ColumnDefinitions="110,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.ColumnSpan="4" Text="センサ" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="1" Text="X" TextColor="Gray" HorizontalOptions="End" />
                    <Label Grid.Row="1" Grid.Column="2" Text="Y" TextColor="Gray" HorizontalOptions="End" />
                    <Label Grid.Row="1" Grid.Column="3" Text="Z" TextColor="Gray" HorizontalOptions="End" />
                    <Label Grid.Row="2" Grid.Column="0" Text="Accel [m/s²]" />
                    <Label Grid.Row="3" Grid.Column="0" Text="Gyro [rad/s]" />
                </Grid>
            </Border>

            <!-- 制御入力 u（列: Thrust / S1〜S4） -->
            <Border Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                <Grid x:Name="ctrlGrid" ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                    <Label Grid.Row="0" Grid.ColumnSpan="5" Text="制御入力 u [%]" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="0" Text="Thrust" TextColor="Gray" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Grid.Column="1" Text="S1" TextColor="Gray" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Grid.Column="2" Text="S2" TextColor="Gray" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Grid.Column="3" Text="S3" TextColor="Gray" HorizontalOptions="Center" />
                    <Label Grid.Row="1" Grid.Column="4" Text="S4" TextColor="Gray" HorizontalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
