<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DroneMonitor.Views.HomeView"
             xmlns:android="clr-namespace:DroneMonitor.Platforms.Android">
    <ScrollView>
        <VerticalStackLayout Padding="12,8" Spacing="12">

            <!-- メッセージとゲームパッド状態、機体タイプ選択 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="msgWindow" Text="" FontSize="14" />
                    <Label x:Name="msgPad" Text="GamePad: -" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label Text="機体:" VerticalOptions="Center" />
                    <RadioButton x:Name="TypeVert" Content="V字" GroupName="TargetGroup" IsChecked="True" />
                    <RadioButton x:Name="TypeXpider" Content="X字" GroupName="TargetGroup" />
                </HorizontalStackLayout>
            </Grid>

            <!-- スロットル（TRIP は画面上部の状態バーにある） -->
            <Border Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                    <HorizontalStackLayout Grid.Row="0" Spacing="12">
                        <Label Text="Throttle" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label x:Name="throttleValueLabel" Text="0%" FontSize="28" FontAttributes="Bold"
                               MinimumWidthRequest="80" VerticalOptions="Center" />
                        <Stepper x:Name="throttleStepper" Minimum="0" Maximum="100" Increment="1" Value="0"
                                 VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Slider x:Name="throttleSeekBar" Grid.Row="1"
                            Maximum="100" Value="0" />
                </Grid>
            </Border>

            <!-- サーボ（名前・スライダー・数値） -->
            <Border Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="40,*,48" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
                    <Label Grid.Row="0" Grid.ColumnSpan="3" Text="サーボ" FontAttributes="Bold" />

                    <Label Grid.Row="1" Grid.Column="0" Text="S1" VerticalOptions="Center" />
                    <Slider x:Name="S1SeekBar" Grid.Row="1" Grid.Column="1" Maximum="100" Value="50" />
                    <Label x:Name="S1ValueLabel" Grid.Row="1" Grid.Column="2" Text="50"
                           HorizontalTextAlignment="End" VerticalOptions="Center" />

                    <Label Grid.Row="2" Grid.Column="0" Text="S2" VerticalOptions="Center" />
                    <Slider x:Name="S2SeekBar" Grid.Row="2" Grid.Column="1" Maximum="100" Value="50" />
                    <Label x:Name="S2ValueLabel" Grid.Row="2" Grid.Column="2" Text="50"
                           HorizontalTextAlignment="End" VerticalOptions="Center" />

                    <Label Grid.Row="3" Grid.Column="0" Text="S3" VerticalOptions="Center" />
                    <Slider x:Name="S3SeekBar" Grid.Row="3" Grid.Column="1" Maximum="100" Value="50" />
                    <Label x:Name="S3ValueLabel" Grid.Row="3" Grid.Column="2" Text="50"
                           HorizontalTextAlignment="End" VerticalOptions="Center" />

                    <Label Grid.Row="4" Grid.Column="0" Text="S4" VerticalOptions="Center" />
                    <Slider x:Name="S4SeekBar" Grid.Row="4" Grid.Column="1" Maximum="100" Value="50" />
                    <Label x:Name="S4ValueLabel" Grid.Row="4" Grid.Column="2" Text="50"
                           HorizontalTextAlignment="End" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- PID の目標姿勢 -->
            <Border Padding="12" Stroke="LightGray" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="目標姿勢（PID）" FontAttributes="Bold" />
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceAround" AlignItems="Center">
                        <VerticalStackLayout Spacing="4" Padding="8">
                            <Label Text="Pitch" HorizontalOptions="Center" />
                            <HorizontalStackLayout Spacing="6">
                                <Stepper x:Name="pitchStepper" Minimum="-30" Maximum="30" Increment="1" Value="-5" />
                                <Label x:Name="pitchValueLabel" Text="-5°" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Padding="8">
                            <Label Text="Roll" HorizontalOptions="Center" />
                            <HorizontalStackLayout Spacing="6">
                                <Stepper x:Name="rollStepper" Minimum="-30" Maximum="30" Increment="1" Value="0" />
                                <Label x:Name="rollValueLabel" Text="0°" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" Padding="8">
                            <Label Text="Yaw" HorizontalOptions="Center" />
                            <HorizontalStackLayout Spacing="6">
                                <Stepper x:Name="yawStepper" Minimum="-180" Maximum="180" Increment="1" Value="0" />
                                <Label x:Name="yawValueLabel" Text="0°" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- AndroidのJoystickView -->
            <OnPlatform x:TypeArguments="View">
                <On Platform="Android">
                    <android:JoystickView x:Name="joystickView" />
                </On>
            </OnPlatform>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
