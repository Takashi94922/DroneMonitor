<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DroneMonitor.Views.NotificationPage"
             Title="Notifications">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, *"
          ColumnDefinitions="Auto,*"
          Padding="12">

        <!-- 位置 -->
        <Label x:Name="positionTextView"
               Grid.Row="0"
               Grid.Column="0"
               Text="Position"
               HorizontalOptions="Start"
               FontSize="18" />
        <Label x:Name="positionValueLabel"
               Grid.Row="0"
               Grid.Column="1"
               Text=""
               WidthRequest="100"
               HorizontalOptions="Start"
               FontSize="18" />

        <!-- 速度 -->
        <Label x:Name="velocityTextView"
               Grid.Row="1"
               Grid.Column="0"
               Text="Velocity"
               HorizontalOptions="Start"
               FontSize="18"
               Margin="0,8,0,0" />
        <Label x:Name="velocityValueLabel"
               Grid.Row="1"
               Grid.Column="1"
               Text=""
               HorizontalOptions="Start"
               FontSize="18"
               WidthRequest="100"
               Margin="0,8,0,0" />

        <!-- 加速度 -->
        <Label x:Name="accelTextView"
               Grid.Row="2"
               Grid.Column="0"
               Text="Acceleration"
               HorizontalOptions="Start"
               FontSize="18"
               Margin="0,8,0,0" />
        <Label x:Name="accelValueLabel"
               Grid.Row="2"
               Grid.Column="1"
               Text=""
               HorizontalOptions="Start"
               WidthRequest="100"
               FontSize="18"
               Margin="0,8,0,0" />

        <!-- コントロール状態 -->
        <Label x:Name="ctrltextView"
               Grid.Row="3"
               Grid.Column="0"
               Text="Control Text"
               HorizontalOptions="Start"
               FontSize="18"
               Margin="0,8,0,0" />
        <Label x:Name="ctrlValueLabel"
               Grid.Row="3"
               Grid.Column="1"
               Text=""
               WidthRequest="100"
               HorizontalOptions="Start"
               FontSize="18"
               Margin="0,8,0,0" />

        <!-- コントロールボタン -->
        <StackLayout Grid.Row="5"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Orientation="Horizontal"
                     HorizontalOptions="Start"
                     Margin="0,0,0,80"
                     Spacing="40">
            <Button x:Name="endControl"
                    Text="EC"
                    WidthRequest="80"
                    HeightRequest="20"/>
            <Button x:Name="beginControl"
                    Text="BC"
                    WidthRequest="80"
                    HeightRequest="20"/>
        </StackLayout>
    </Grid>
</ContentPage>